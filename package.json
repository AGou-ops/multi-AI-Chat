{
  "name": "multi-aichat",
  "version": "0.1.0",
  "private": true,
  "description": "A macOS Electron workbench for using multiple online AI chat platforms side by side.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:clean": "rm -rf node_modules/.vite",
    "dev": "npm run dev:clean && electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "com.multiaichat.app",
    "productName": "Multi AI Chat",
    "icon": "build/app-icon.png",
    "files": [
      "dist/**"
    ],
    "dmg": {
      "writeUpdateInfo": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
